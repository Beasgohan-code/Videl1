# There is no separate/global Music bot configuration. The worker loads the
# shared VidelBot/config.env (or host environment) and clone credentials from
# the registry. Configure API_ID, API_HASH, MONGO_URI/DB_URI and the exact
# existing ENCRYPTION_KEY used by the Videl controller on the worker service.
# Never generate a replacement key for a database containing encrypted secrets.
CLONE_PROFILES_SINGLE_INSTANCE=True
MUSIC_CLONE_WORKER=1
MUSIC_WORKER_SYNC_SECONDS=10

# Do not set BOT_TOKEN or STRING_SESSION here; both are clone-specific encrypted
# database fields and are never copied into the worker's global environment.
