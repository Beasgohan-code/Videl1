# --- Telegram API Credentials (Required) ---
API_ID=12345678
API_HASH=your_api_hash_here
BOT_TOKEN=your_bot_token_here

# --- Assistant Pyrogram String Session(s) (Required, comma-separated for multiple) ---
STRING_SESSIONS=your_pyrogram_string_session_here

# --- MongoDB Database (Required) ---
MONGO_DB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# --- Owner & Log Group (Required) ---
OWNER_ID=123456789
LOGGER_ID=-1001234567890

# --- Optional media API (faster audio/video resolution) ---
MEDIA_API_URL=https://host-repository.vercel.app
MEDIA_API_KEY=your_media_api_key_here

# --- Community Links (Optional) ---
SUPPORT_CHANNEL=https://t.me/your_channel
SUPPORT_GROUP=https://t.me/your_group
GITHUB_REPO=https://github.com/Beasgohan-code/Videl1
UPSTREAM_REPO=https://github.com/Beasgohan-code/Videl1
UPSTREAM_BRANCH=main

# --- Optional Spotify / Cookies / Proxy ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YT_COOKIES=
PROXY_URL=

# --- Optional Settings ---
DURATION_LIMIT=5400
AUTO_LEAVING_ASSISTANT=False
PRIVATE_BOT_MODE=False
INSTANT_PLAY=True
VC_LYRICS=True
