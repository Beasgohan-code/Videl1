# ───────────── Required ─────────────
BOT_TOKEN=            # from @BotFather
API_ID=               # from https://my.telegram.org
API_HASH=
DB_URI=               # mongodb+srv://user:pass@cluster/...
OWNER_ID=             # your Telegram user id (space separated for several owners)

# ───────────── Recommended ─────────────
LOG_CHANNEL=          # -100… channel/group id, bot must be admin (new users, startup, errors)
ENCRYPTION_KEY=       # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
BOT_NAME=Videl
START_PIC=            # one or more image URLs (space separated) for /start – empty → random anime pic
RANDOM_START_PIC=True # pick a random START_PIC (or API pic) each time
FORCE_PIC=            # image for the force-subscribe screen
START_REACTIONS=True  # react to /start with a random emoji
MESSAGE_EFFECTS=True  # animated message effects (🔥 🎉) in private chats
STREAM_REPLIES=True   # live "typing" previews + "Thinking…" placeholder (sendMessageDraft, private chats)
ERROR_MESSAGE=True    # send unhandled error tracebacks to LOG_CHANNEL

# ───────────── aiogram · Bot API 10.3 bridge ─────────────
AIOGRAM_ENABLED=True      # outgoing Bot API client next to pyrofork (every call falls back to MTProto)
COLORED_BUTTONS=True      # green / red / blue inline buttons (Bot API "style")
EPHEMERAL_REPLIES=True    # /help /id /info /guide in groups → visible only to the caller
MANAGED_BOTS=True         # ⚡ one-tap clone creation – also enable Bot Management Mode in @BotFather
MANAGED_PAIR_TIMEOUT=300  # seconds to wait for the user to confirm the new bot
BOT_API_URL=              # optional self-hosted Bot API server, e.g. http://localhost:8081

# ───────────── Owner log channel ─────────────
# LOG_CHANNEL (above) receives every event: #BotStarted #BotStopped #NewUser #Start #CloneCreated
# #CloneDeleted #CloneStarted/Stopped/Restarted/Transferred/Restored/Hibernated/Failed/Healed
# #LinkGenerated #Login #Logout #PremiumAdded/Removed #StarsPayment #Refund #Ban #Unban #Broadcast
# #Maintenance #FsubAdded/Removed #LowDisk #AutoRestart #Restart #Update #DailyReport #Error
# #Subscription #Referral #Redeem #CodesCreated #Trial #Support #AdminAction #BotPhoto
# #AdminAdded #AdminRemoved #RenameVerified
OWNER_DM_EVENTS=BotStarted BotStopped CloneCreated CloneDeleted StarsPayment LowDisk AutoRestart  # also DM'd to owners
LOG_START_EVENTS=True        # log returning users who press /start (new users are always logged)
START_LOG_COOLDOWN_MIN=60    # at most one #Start per user per N minutes
LOG_LOGINS=True              # log saver /login and /logout (phone masked, sessions never logged)
LOG_LINKS=True               # log clone-bot link generation
DAILY_REPORT=True            # daily activity summary
DAILY_REPORT_HOUR=0          # hour (0-23) in LOG_TZ
LOG_TZ=Asia/Kolkata          # timezone of log timestamps
CONTACT_URL=          # e.g. https://t.me/your_username – "Contact admin / buy premium" buttons
UPDATES_URL=          # optional updates channel link
SUPPORT_URL=          # optional support group link

# ───────────── Force subscribe ─────────────
FSUB_CHANNELS=        # -100… ids or @usernames (space separated); bot must be admin. Or use /add_fsub
FSUB_REQUEST_MODE=False  # default for new channels: True → join-request links (a pending request counts). Per channel: /fsub_mode

# ───────────── Auto-Rename ─────────────
RENAME_DUMP_CHANNEL=      # copy every renamed file here (bot must be admin) – also settable in /renameset
RENAME_CONCURRENCY=3      # files processed at the same time (all users)
RENAME_QUEUE_LIMIT=30     # max queued files per user
LEADERBOARD_PIC=          # optional photo for /leaderboard
LEADERBOARD_DELETE_TIMER=30  # seconds before /leaderboard is auto-deleted in groups (0 = never)

# ───────────── Permissions ─────────────
SUDO_USERS=           # encoder sudo + bot admins
ADMINS=               # extra bot admins (ban / broadcast / premium) – owners can add more live with /add_admin
EVERYONE_CHATS=       # chats/users allowed to use the encoder
ENCODER_PUBLIC=False  # True → anyone can use the encoder (CPU heavy!)

# ───────────── Content saver ─────────────
FREE_LIMIT_DAILY=10
FREE_LIMIT_SIZE_GB=2
PREMIUM_PRICES=1 Month: ₹50 / $1 | 3 Months: ₹120 / $2.5 | Lifetime: ₹200 / $4
UPI_ID=
QR_CODE=              # payment QR image URL
SUBSCRIPTION=         # banner image for /plan and limit messages
STARS_PLANS=30:100 90:250 0:500   # Telegram Stars plans  days:stars  (0 days = lifetime). Empty → disabled
SUBSCRIPTION_STARS=90 # monthly auto-renewing Stars subscription (⭐ per 30 days). 0 → disabled
GIFTS_ENABLED=True    # users can buy Premium for a friend (/gift, native user picker)

# ───────────── Growth ─────────────
REFERRAL_TARGET=5     # every N genuinely new users via /refer link …
REFERRAL_REWARD_DAYS=3  # … earn this many Premium days (0 → no rewards)
TRIAL_DAYS=1          # /trial – once per account (0 → disabled)
SUPPORT_ENABLED=True  # /support inbox – messages land in the owners' DM, reply to answer

# ───────────── Clone (worker) bots ─────────────
CLONE_ENABLED=True
MAX_BOTS_PER_USER=1
BOT_CREATION_COOLDOWN=30   # seconds
CLONE_INACTIVE_DAYS=7      # clones nobody used for this many days are deactivated (owner warned a day before, 0 = never)
DEFAULT_AUTO_DELETE=0      # seconds, 0 = off
MAIN_LOG_CHANNEL=          # defaults to LOG_CHANNEL
BACKEND_API_URL=           # optional Cloudflare worker (filestore/backend) for permanent links
BACKEND_API_SECRET=

# ───────────── Databases (optional names) ─────────────
DB_NAME=SaveRestricted2
ENCODER_DB_NAME=VideoEncoder
FS_DB_NAME=VidelFileStore
VIDEL_DB_NAME=Videl

# ───────────── Encoder storage ─────────────
DOWNLOAD_DIR=VideoEncoder/utils/extras/downloads/
ENCODE_DIR=VideoEncoder/utils/extras/encodes/
DRIVE_DIR=            # Google Drive folder id for /gupload (needs token.pickle)
INDEX_URL=

# ───────────── Encoder engine ─────────────
ENCODER_WORKERS=1         # encodes running at the same time (raise on a strong server / GPU)
ENC_MAX_TASKS_FREE=3      # queued + running tasks per free user
ENC_MAX_TASKS_PRO=10      # … per Encoder Pro / Premium user (admins: unlimited). Pro tasks run first
HW_ENCODER=auto           # auto | nvenc | qsv | vaapi | off – auto test-encodes once at boot
VAAPI_DEVICE=/dev/dri/renderD128
SPLIT_SIZE_MB=1950        # results / leeches above this are split into parts (50-1990, bot limit is 2 GB)
LEECH_FREE_GB=2           # /leech size limit (free)
LEECH_PRO_GB=8            # /leech size limit (Encoder Pro / Premium)
LEECH_ALLOW_PRIVATE=False # True lets /leech reach private / local addresses – keep False on public bots
QUEUE_PERSIST=True        # the encoder queue survives restarts (re-queued from Mongo, max 48 h old)
SINGLE_INSTANCE=True      # only one running copy per bot token – stops doubled replies/encodes during redeploys
SOURCE_CACHE_MIN=60       # a downloaded file is reused by the next task on it for N minutes (0 = off)
SOURCE_CACHE_GB=10        # cap for that cache (it also empties itself when free disk < 10 %)
FAST_DL=True              # parallel Telegram downloads (several chunks in flight) – off = stock downloader
FAST_DL_WORKERS=6         # chunk requests in flight per download (1-16; 4-8 is the sweet spot)

# ───────────── Owner tools ─────────────
ADMIN_WEB_TOKEN=          # set a long random string to enable https://<your-app>/admin (open it as /admin#TOKEN)
BACKUP_ENABLED=True       # daily gzip JSON backup of every database
BACKUP_HOUR=4             # 0-23 in LOG_TZ
BACKUP_CHAT=0             # chat id for backups; 0 → first owner's DM
BACKUP_INCLUDE_SECRETS=False  # True also stores users' /login sessions – only if the backup chat is private!
DEFAULT_LANG=en           # en hi ml ta es id ru ar – for users whose Telegram language isn't supported

# ───────────── Keep-alive & watchdog ─────────────
KEEP_ALIVE_URL=           # public URL of this app; auto-detected on Render/Koyeb/Railway/Heroku. Empty on a VPS
KEEP_ALIVE_INTERVAL=240   # seconds between self-pings
WATCHDOG_INTERVAL=600     # seconds between watchdog sweeps
CLEANUP_AFTER_HOURS=6     # delete temp downloads/encodes older than this
MIN_FREE_DISK_GB=2        # below this → aggressive cleanup + owner alert
STATE_TIMEOUT_MIN=15      # abandon /login and clone-setup flows after this
AUTO_RESTART_ON_HANG=True # restart the process if Telegram is unreachable 3 checks in a row

# Inline "# comments" like these are fine: python-dotenv strips them, and Videl strips them
# itself too when values arrive via `docker run --env-file` or a hosting dashboard.

# ───────────── Misc ─────────────
FREEIMAGE_API_KEY=    # optional; empty → catbox.moe is used for uploads
SOURCE_URL=https://github.com/Beasgohan-code/Videl1
PORT=8080
TG_BOT_WORKERS=16
MAX_LINK_FILES=1000      # most files a single clone-bot share / batch link may deliver
