# ───────────── Required ─────────────
BOT_TOKEN=            # from @BotFather
API_ID=               # from https://my.telegram.org
API_HASH=
DB_URI=               # mongodb+srv://user:pass@cluster/...
OWNER_ID=             # your Telegram user id (space separated for several owners)

# ───────────── Recommended ─────────────
LOG_CHANNEL=          # -100… channel/group id, bot must be admin (new users, startup, errors)
ENCRYPTION_KEY=       # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
BOT_NAME=Videl
START_PIC=            # image URL shown on /start (optional)
CONTACT_URL=          # e.g. https://t.me/your_username – "Contact admin / buy premium" buttons
UPDATES_URL=          # optional updates channel link
SUPPORT_URL=          # optional support group link

# ───────────── Permissions ─────────────
SUDO_USERS=           # encoder sudo + bot admins
ADMINS=               # extra bot admins (ban / broadcast / premium)
EVERYONE_CHATS=       # chats/users allowed to use the encoder
ENCODER_PUBLIC=False  # True → anyone can use the encoder (CPU heavy!)

# ───────────── Content saver ─────────────
FREE_LIMIT_DAILY=10
FREE_LIMIT_SIZE_GB=2
PREMIUM_PRICES=1 Month: ₹50 / $1 | 3 Months: ₹120 / $2.5 | Lifetime: ₹200 / $4
UPI_ID=
QR_CODE=              # payment QR image URL
SUBSCRIPTION=         # banner image for /plan and limit messages

# ───────────── Clone (worker) bots ─────────────
CLONE_ENABLED=True
MAX_BOTS_PER_USER=1
BOT_CREATION_COOLDOWN=30   # seconds
HIBERNATION_HOURS=48       # idle clones are stopped after this
DEFAULT_AUTO_DELETE=0      # seconds, 0 = off
MAIN_LOG_CHANNEL=          # defaults to LOG_CHANNEL
BACKEND_API_URL=           # optional Cloudflare worker (filestore/backend) for permanent links
BACKEND_API_SECRET=

# ───────────── Databases (optional names) ─────────────
DB_NAME=SaveRestricted2
ENCODER_DB_NAME=VideoEncoder
FS_DB_NAME=VidelFileStore
VIDEL_DB_NAME=Videl

# ───────────── Encoder storage ─────────────
DOWNLOAD_DIR=VideoEncoder/utils/extras/downloads/
ENCODE_DIR=VideoEncoder/utils/extras/encodes/
DRIVE_DIR=            # Google Drive folder id for /gupload (needs token.pickle)
INDEX_URL=

# ───────────── Misc ─────────────
FREEIMAGE_API_KEY=    # optional; empty → catbox.moe is used for uploads
SOURCE_URL=https://github.com/Beasgohan-code/Videl1
PORT=8080
TG_BOT_WORKERS=16
