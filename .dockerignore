# Root .dockerignore — only VidelBot/ and root requirements.txt enter the build context
.git
.github
**/__pycache__
**/*.pyc
**/*.session
**/*.session-journal
**/config.env
**/.env
**/token.pickle
**/token.json
**/credentials.json
**/.pytest_cache
VidelBot/tests
VidelBot/pytest.ini
VidelBot/logs
VidelBot/downloads
VidelBot/plugins/.staging
VidelBot/VideoEncoder/utils/extras/downloads
VidelBot/VideoEncoder/utils/extras/encodes
VidelBot/.restart_reason
VidelBot/.restart_msg.json

# Root-anchored legacy prototype & docs (never match files inside VidelBot/)
