---
import ThemeToggle from '../components/ThemeToggle';
import '../styles/global.css';
interface Props {title:string; description:string;}
const {title,description}=Astro.props;
const links=[['Features','/features'],['Hosting','/cloud-hosting'],['Developer tools','/developer-tools'],['Docs','/documentation']];
---
<!doctype html><html lang="en" data-theme="dark"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#0b0e13"/><title>{title} · Videl</title><script is:inline>try{const t=localStorage.getItem('videl_public_theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t}catch{}</script></head><body>
<a class="skip" href="#main">Skip to content</a><header class="site-header"><div class="container nav"><a class="brand" href="/" aria-label="Videl home"><span class="brand-symbol">v<span>.</span></span><span>videl</span><small> / studio</small></a><nav class="desktop-nav" aria-label="Main navigation">{links.map(([label,url])=><a href={url}>{label}</a>)}</nav><div class="nav-actions"><ThemeToggle client:load/><a class="nav-signin" href="/app">Sign in</a><a class="button button-small" href="/app">Open Studio <span aria-hidden="true">↗</span></a><details class="mobile-nav"><summary aria-label="Open navigation">☰</summary><nav aria-label="Mobile navigation">{links.map(([label,url])=><a href={url}>{label}</a>)}<a href="/pricing">Pricing</a><a href="/faq">FAQ</a><a href="/app">Sign in</a></nav></details></div></div></header>
<main id="main"><slot/></main><footer class="site-footer"><div class="container footer-main"><div><a class="brand" href="/"><span class="brand-symbol">v<span>.</span></span><span>videl</span><small> / studio</small></a><p>A workspace for the things you build with Telegram.</p><span class="footer-note">Under development · capabilities vary</span></div><div class="footer-links"><div><strong>EXPLORE</strong><a href="/features">Features</a><a href="/telegram-bot-hosting">Telegram bots</a><a href="/cloud-hosting">Cloud hosting</a><a href="/ai-development">AI development</a></div><div><strong>RESOURCES</strong><a href="/documentation">Documentation</a><a href="/api">API</a><a href="/templates">Templates</a><a href="/changelog">Changelog</a></div><div><strong>VIDEL</strong><a href="/pricing">Pricing</a><a href="/faq">FAQ</a><a href="/support">Support</a><a href="/app">Open Studio</a></div></div></div><div class="container footer-bottom"><span>VIDEL / MADE FOR YOUR NEXT IDEA</span><span>Built around your existing Telegram bots.</span></div></footer>
</body></html>
