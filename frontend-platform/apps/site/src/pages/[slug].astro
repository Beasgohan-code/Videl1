---
import Layout from '../layouts/Layout.astro';
import {pages} from '../pages-content';
type Slug = keyof typeof pages;
export function getStaticPaths(){return Object.keys(pages).map(slug=>({params:{slug}}));}
const slug=Astro.params.slug as Slug;
const page=pages[slug];
---
<Layout title={page.title} description={page.intro}><div class="container subpage"><div class="subpage-top"><a href="/">← Home</a><span>VIDEL / {page.eyebrow}</span></div><div class="subpage-hero"><div><span class="section-index">{page.eyebrow}</span><h1>{page.title}</h1><p>{page.intro}</p><div class="hero-actions"><a href="/app" class="button">Open Studio <span aria-hidden="true">↗</span></a><a href="/features" class="text-link">Explore features →</a></div></div><div class="subpage-mark" aria-hidden="true"><span>v.</span><small>BUILD / WITH CLARITY</small></div></div><div class="status-strip"><span>✳</span><p>{page.status}</p></div><section class="subpage-content"><div><span class="section-index">WHAT TO KNOW</span><h2>Built around<br/><em>what's real.</em></h2></div><div class="subpage-sections">{page.sections.map(([heading,body],i)=><article><span>{String(i+1).padStart(2,'0')}</span><div><h3>{heading}</h3><p>{body}</p>{slug==='support' && i===1 && <a href="https://github.com/Beasgohan-code/Videl1/issues">Open the issue tracker ↗</a>}</div></article>)}</div></section></div></Layout>
